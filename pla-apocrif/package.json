{
    "name": "pla-apocrif",
    "private": true,
    "version": "0.1.0",
    "description": "Generador de textos originals a la manera de Josep Pla, amb l'API d'Anthropic",
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
        "dev:server": "node --watch-path=server --watch-path=shared server/index.js",
        "dev:client": "vite",
        "build": "vite build",
        "start": "node server/index.js",
        "prova": "node scripts/prova.js",
        "test": "node --test"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.137.0",
        "express": "^5.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.5"
    }
}
