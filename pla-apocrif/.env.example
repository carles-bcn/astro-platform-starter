# Copia aquest fitxer a .env i omple'l. El .env no es puja mai al repositori.

# Clau de l'API d'Anthropic (https://console.anthropic.com/). Només la llegeix el servidor.
ANTHROPIC_API_KEY=

# Model que escriu els textos.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional: esforç de raonament (low, medium, high, xhigh, max). Per defecte, medium.
# Deixa'l buit si fas servir un model que no admet aquest paràmetre.
# ANTHROPIC_EFFORT=medium

# Opcional: port del servidor Express (per defecte, 3001).
# PORT=3001
